{
  "manifest_version": 3,
  "name": "Irène",
  "short_name": "Irène",
  "version": "0.2.0",
  "description": "Le lanceur d’alerte de vos démarches en ligne.",
  "action": {
    "default_title": "Irène",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "analysePage.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "irene@extensions.local",
      "strict_min_version": "128.0"
    }
  }
}
